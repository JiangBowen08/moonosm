name = "JiangBowen08/moonosm"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/JiangBowen08/moonosm"

license = "Apache-2.0"

keywords = [ "osm", "pbf", "geospatial", "protocol-buffers" ]

preferred_target = "wasm"

description = "Bounded MoonBit reader for raw and zlib OpenStreetMap PBF blocks, primitives, and geometry"
